neo-j2k oracle patch 0001: the general truncation fix (keep every delivered byte)

SPDX-License-Identifier: BSD-2-Clause
Source: the fork audit of 2026-11-18 (Vulkanstorm reports/neo-j2k-survey-2026-11-18/,
fork-audit.md section 5, work/keep-layers-general.patch), unchanged. It applies to
anne-skydancer/openjpeg 3b1a6a96 and changes non-strict decoding only:
- a cut inside a code-block's contribution keeps every codeword segment completed before
  the cut and everything earlier packets gave (OpenJPEG dropped the code-block, earlier
  layers included);
- a packet header cut by the end of the data, or an EPH marker missing because the data
  ended, counts as an absent packet instead of failing the decode.
Whole files decode bit-identically to the unpatched fork. The patch leaves the pin when
the fork's stage 1a hotfix (branch vkstorm-2.5.4-hotfix) is pushed: that branch carries
this change, and oracle/PIN then names its commit with no patch.

--- a/src/lib/openjp2/bio.h
+++ b/src/lib/openjp2/bio.h
@@ -64,6 +64,8 @@
     OPJ_UINT32 buf;
     /** coder : number of bits free to write. decoder : number of bits read */
     OPJ_UINT32 ct;
+    /** decoder: a read needed a byte past the end of the buffer */
+    OPJ_BOOL overrun;
 } opj_bio_t;
 
 /** @name Exported functions */
--- a/src/lib/openjp2/bio.c
+++ b/src/lib/openjp2/bio.c
@@ -88,6 +88,7 @@
     bio->buf = (bio->buf << 8) & 0xffff;
     bio->ct = bio->buf == 0xff00 ? 7 : 8;
     if ((OPJ_SIZE_T)bio->bp >= (OPJ_SIZE_T)bio->end) {
+        bio->overrun = OPJ_TRUE;
         return OPJ_FALSE;
     }
     bio->buf |= *bio->bp++;
@@ -135,6 +136,7 @@
     bio->bp = bp;
     bio->buf = 0;
     bio->ct = 8;
+    bio->overrun = OPJ_FALSE;
 }
 
 void opj_bio_init_dec(opj_bio_t *bio, OPJ_BYTE *bp, OPJ_UINT32 len)
@@ -144,6 +146,7 @@
     bio->bp = bp;
     bio->buf = 0;
     bio->ct = 0;
+    bio->overrun = OPJ_FALSE;
 }
 
