struct EncT1 {
    MqEnc mqc;
    OPJ_UINT32 w, h;
    alignas(64) OPJ_INT32 data[kMaxSamples];
    alignas(64) opj_flag_t flags[kFlagCount];
    EncPass passes[kMaxPasses];
    std::uint8_t out[1 + kOutCapacity];  // out[0] is the fake byte before the code-block's
};
